# openterm-theme-version = 3
font-family = JetBrains Mono
font-size = 15
font-thicken = true
font-feature = calt
font-feature = liga
background = #050810
foreground = #edf2ff
cursor-color = #5eead4
cursor-style = block
selection-background = #2563eb
selection-foreground = #ffffff
background-opacity = 0.92
background-blur-radius = 40
window-padding-x = 22
window-padding-y = 18
window-padding-balance = true
window-theme = dark
macos-titlebar-style = transparent
macos-window-shadow = true
shell-integration = detect
copy-on-select = clipboard
palette = 0=#050810
palette = 1=#fb7185
palette = 2=#4ade80
palette = 3=#facc15
palette = 4=#60a5fa
palette = 5=#c084fc
palette = 6=#2dd4bf
palette = 7=#edf2ff
palette = 8=#64748b
palette = 9=#fda4af
palette = 10=#86efac
palette = 11=#fde047
palette = 12=#93c5fd
palette = 13=#d8b4fe
palette = 14=#99f6e4
palette = 15=#f8fafc
